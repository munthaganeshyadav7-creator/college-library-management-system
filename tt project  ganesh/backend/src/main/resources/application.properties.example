# ===================================================================
# COLLEGE LIBRARY MANAGEMENT SYSTEM - CONFIGURATION EXAMPLE
# Rename or copy to application.properties and configure for your local environment.
# ===================================================================

server.port=8080
spring.application.name=College Library Management System

# MySQL 8 Database Configuration
# Set your MySQL username and password below, or configure environment variables:
# set DB_USERNAME=root
# set DB_PASSWORD=your_mysql_password
spring.datasource.url=jdbc:mysql://${DB_HOST:localhost}:${DB_PORT:3306}/${DB_NAME:library_db}?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
spring.datasource.username=${DB_USERNAME:root}
spring.datasource.password=${DB_PASSWORD:root}
spring.datasource.driver-class-name=com.mysql.cj.jdbc.Driver

# JPA / Hibernate
spring.jpa.hibernate.ddl-auto=update
spring.jpa.show-sql=false

# Security & Business Logic Settings
jwt.secret=9a6747f3b5e4e207914f7b49463942078696d5b066bfda89ecf4c9c1b9794024
jwt.expiration-ms=86400000
library.penalty.daily-rate=5.00
library.loan.duration-days=7
